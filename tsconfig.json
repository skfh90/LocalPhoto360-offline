{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@shared-components/*": ["shared/components/*"],
      "@shared-constants": ["shared/constants"],
      "@shared-utils": ["shared/utils"],
      "@fonts": ["shared/theme/fonts"],
      "@screens/*": ["screens/*"],
      "@models/*": ["models/*"],
      "@hooks/*": ["hooks/*"]
    },
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "App.tsx", "custom.d.ts"]
}
